---
import type { LegalDocument } from '../data/documents';

interface Props {
  doc: LegalDocument;
}

const { doc } = Astro.props;
const pillClass = doc.colorTheme === 'blue' ? 'version-pill' : `version-pill pill-${doc.colorTheme}`;
---

<header class="doc-hero">
  <div class="doc-hero-inner">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="index.html">Legal Portal</a>
      <span>/</span>
      <span aria-current="page">{doc.shortTitle}</span>
    </nav>
    <div class="doc-title-row">
      <div>
        <h1 class="doc-title">{doc.title}</h1>
        <div class="doc-meta-strip">
          <span class="meta-tag">Last Revised: <strong>{doc.lastRevised}</strong></span>
          <span class={pillClass}>{doc.version}</span>
          <span class="meta-tag">Category: <strong>{doc.category}</strong></span>
        </div>
      </div>
      <div class="hero-actions">
        <a href={doc.outputPdf} class="btn-action btn-action-primary" target="_blank" rel="noopener noreferrer" title="Download Vector PDF">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>PDF</span>
        </a>
        <a href={doc.outputTxt} class="btn-action btn-action-txt" target="_blank" rel="noopener noreferrer" title="View Monospaced Plain Text">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>TXT</span>
        </a>
        <button type="button" class="btn-action" onclick="window.print()" title="Print this document">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>Print</span>
        </button>
        <button type="button" class="btn-action" onclick="copyShareLink()" title="Copy document share link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span>Share</span>
        </button>
      </div>
    </div>
  </div>
</header>
