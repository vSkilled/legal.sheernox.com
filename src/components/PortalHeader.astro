---
import { LEGAL_DOCUMENTS } from '../data/documents';

interface Props {
  currentSlug?: string;
  isSubPage?: boolean;
  showBackToMain?: boolean;
}

const { currentSlug = '', isSubPage = false, showBackToMain } = Astro.props;
const isSub = isSubPage || (showBackToMain !== undefined ? showBackToMain : Boolean(currentSlug));
---

<nav class="top-nav" aria-label="Portal Navigation">
  <div class="top-nav-inner">
    <a href="index.html" class="nav-brand">
      <img src="https://cdn.sheernox.com/logo/white_icon_with_white_text/logo_300.png" alt="Sheernox" class="nav-logo" />
      <div class="nav-divider"></div>
      <span class="nav-portal-label">Legal Portal</span>
    </a>
    <div class="nav-actions">
      {isSub && (
        <a href="index.html" class="nav-link" aria-label="Back to Legal Portal Homepage">
          <span class="nav-link-full">&larr; Portal Home</span>
          <span class="nav-link-short">&larr; Home</span>
        </a>
      )}
      <div class="policy-switcher">
        <label for="policySwitcher" class="sr-only">Switch Policy</label>
        <div class="policy-select-wrap">
          <select
            id="policySwitcher"
            class="policy-select"
            aria-label="Switch between legal policies"
            onchange="if(this.value) window.location.href=this.value;"
          >
            <option value="" disabled selected={!currentSlug}>
              Switch Policy...
            </option>
            {LEGAL_DOCUMENTS.map((doc) => (
              <option value={doc.sourceHtml} selected={currentSlug === doc.slug}>
                {doc.shortTitle}
              </option>
            ))}
          </select>
          <svg class="select-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>
      <a href="https://my.sheernox.com" class="nav-btn" target="_blank" rel="noopener noreferrer">Client Portal</a>
    </div>
  </div>
</nav>

<style>
  .top-nav {
    background-color: var(--sn-dark-navy, #071322);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 24px;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .top-nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .nav-logo {
    height: 30px;
    width: auto;
  }

  .nav-divider {
    height: 22px;
    width: 1.5px;
    background: rgba(255, 255, 255, 0.25);
    margin: 0 4px;
  }

  .nav-portal-label {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: nowrap;
  }

  .nav-link {
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link-short {
    display: none;
  }

  /* Policy Switcher Dropdown */
  .policy-switcher {
    display: inline-flex;
    align-items: center;
  }

  .policy-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .policy-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    color: #e2e8f0;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 6px 30px 6px 12px;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.4;
    transition: all 0.2s ease;
    max-width: 220px;
  }

  .policy-select:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .policy-select:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.25);
  }

  .policy-select option {
    background: #071322;
    color: #f1f5f9;
    padding: 8px 12px;
  }

  .select-chevron {
    position: absolute;
    right: 10px;
    pointer-events: none;
    color: #94a3b8;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .nav-btn {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.25);
  }

  @media (max-width: 820px) {
    .policy-select {
      max-width: 170px;
      font-size: 0.78rem;
      padding: 5px 26px 5px 10px;
    }
  }

  @media (max-width: 640px) {
    .top-nav {
      padding: 10px 16px;
    }
    .nav-brand .nav-divider,
    .nav-brand .nav-portal-label {
      display: none;
    }
    .nav-logo {
      height: 24px;
    }
    .nav-actions {
      gap: 8px;
    }
    .nav-link {
      font-size: 0.78rem;
      white-space: nowrap;
    }
    .nav-link-full {
      display: none;
    }
    .nav-link-short {
      display: inline;
    }
    .policy-select {
      max-width: 120px;
      font-size: 0.74rem;
      padding: 5px 22px 5px 6px;
    }
    .select-chevron {
      right: 6px;
    }
    .nav-btn {
      padding: 5px 10px;
      font-size: 0.78rem;
    }
  }

  @media print {
    .top-nav {
      display: none !important;
    }
  }
</style>
