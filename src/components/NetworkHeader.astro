---
// Sheernox Technology Group Network Header
// Standardized across all Sheernox network properties (sheernox.com, legal.sheernox.com, etc.)
interface Props {
  activeProperty?: 'sheernox' | 'hostblizzard' | 'vpstitan' | 'uptimehawk' | 'fourup';
}

const { activeProperty = 'sheernox' } = Astro.props;

const networkProperties = [
  { id: 'sheernox', name: 'Sheernox.com', url: 'https://sheernox.com' },
  { id: 'hostblizzard', name: 'HostBlizzard.com', url: 'https://hostblizzard.com' },
  { id: 'vpstitan', name: 'VPSTitan.com', url: 'https://vpstitan.com' },
  { id: 'uptimehawk', name: 'UptimeHawk.com', url: 'https://uptimehawk.com' },
  { id: 'fourup', name: '4Up.ca', url: 'https://4up.ca' },
];
---

<header class="network-bar" role="banner" aria-label="Sheernox Technology Group Network Navigation">
  <div class="network-bar-inner">
    <nav class="network-tabs" aria-label="Sheernox Technology Group Network">
      {
        networkProperties.map((prop) => (
          <a
            href={prop.url}
            class={`network-tab ${activeProperty === prop.id ? 'active' : ''}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>{prop.name}</span>
          </a>
        ))
      }
    </nav>
    <div class="network-brand-badge">
      <span class="network-entity">Sheernox Technology Group</span>
    </div>
  </div>
</header>

<style>
  .network-bar {
    background-color: #040911;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    height: 34px;
    width: 100%;
    position: relative;
    z-index: 60;
    font-size: 0.75rem;
  }

  .network-bar-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .network-tabs {
    display: flex;
    align-items: stretch;
    height: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .network-tabs::-webkit-scrollbar {
    display: none;
  }

  .network-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    height: 100%;
    color: #94a3b8;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.74rem;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    transition: all 0.15s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .network-tab:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.04);
  }

  .network-tab.active {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    font-weight: 600;
    border-right-color: rgba(2, 132, 199, 0.5);
    box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.2);
  }

  .network-brand-badge {
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .network-entity {
    font-size: 0.68rem;
    color: #94a3b8;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  @media (max-width: 840px) {
    .network-brand-badge {
      display: none;
    }
    .network-bar-inner {
      padding: 0 8px;
    }
    .network-tab {
      padding: 0 10px;
      font-size: 0.72rem;
    }
  }

  @media print {
    .network-bar {
      display: none !important;
    }
  }
</style>
