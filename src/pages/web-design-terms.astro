---
import LegalDocumentLayout from '../layouts/LegalDocumentLayout.astro';
import { DOC_BY_SLUG } from '../data/documents';

const doc = DOC_BY_SLUG.get('web-design-terms')!;

const tocItems = [
  {
    "id": "sec-preamble",
    "num": "0.0",
    "title": "Scope of Agency Services"
  },
  {
    "id": "sec-1",
    "num": "1.0",
    "title": "Project Lifecycle & Staging"
  },
  {
    "id": "sec-2",
    "num": "2.0",
    "title": "Technology Stacks"
  },
  {
    "id": "sec-3",
    "num": "3.0",
    "title": "Technical Specifications"
  },
  {
    "id": "sec-4",
    "num": "4.0",
    "title": "Collaboration & Revisions"
  },
  {
    "id": "sec-5",
    "num": "5.0",
    "title": "Hosting & External Deploys"
  },
  {
    "id": "sec-6",
    "num": "6.0",
    "title": "30-Day Post-Launch Warranty"
  },
  {
    "id": "sec-7",
    "num": "7.0",
    "title": "Website Care & Maintenance"
  },
  {
    "id": "sec-8",
    "num": "8.0",
    "title": "Client Materials & Assets"
  },
  {
    "id": "sec-9",
    "num": "9.0",
    "title": "Intellectual Property & IP"
  },
  {
    "id": "sec-10",
    "num": "10.0",
    "title": "Payment Terms & Deposits"
  },
  {
    "id": "sec-11",
    "num": "11.0",
    "title": "Refund Policy & Fees"
  },
  {
    "id": "sec-12",
    "num": "12.0",
    "title": "Browser & Device Standards"
  },
  {
    "id": "sec-13",
    "num": "13.0",
    "title": "Limitation of Liability"
  },
  {
    "id": "sec-14",
    "num": "14.0",
    "title": "Governing Law & Venue"
  }
];

const badgeText = "15 Sections";
const metaDescription = "Master agency terms governing custom web development, UI/UX architecture, branding, e-commerce, application engineering, and ongoing website care plans by Sheernox Technology Group.";
---

<LegalDocumentLayout doc={doc} tocItems={tocItems} badgeText={badgeText} metaDescription={metaDescription}>
<!-- Preamble Section -->
<section class="legal-section" id="sec-preamble">
<div class="section-header">
<h2 class="section-title"><span class="section-num">0.0</span> Preamble &amp; Scope of Agency Services</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-preamble')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>This Master Agreement sets the standard terms for all creative, branding, UI/UX design, custom web engineering, e-commerce, application development, and ongoing website care services provided by Sheernox Technology Group. Specific deliverables, technologies, timelines, and budgets are defined in your project Statement of Work (SOW).</p>
</div>
<p>
            This Creative &amp; Web Development Services Agreement is entered into by and between <strong>Sheernox Technology Group</strong> ("Sheernox", "Agency", "We", "Us", or "Our"), a sole proprietorship registered in the Province of British Columbia, Canada (Registration Number: <code>FM0707819</code>, Business Number: <code>732754924BC0001</code>, Original Registration Date: October 29, 2009), based at 1-1885 Grasslands Blvd, Kamloops, BC, V2B 0B8, Canada, and the commissioning client, business, or individual ("Customer", "Client", or "You") identified in an accompanying Statement of Work, estimate, project proposal, or service invoice.
          </p>
<div class="clause-block" id="clause-preamble-1">
<p>
<span class="clause-num">0.1</span> <strong>Scope of Agency Services:</strong> Sheernox provides comprehensive digital agency and engineering solutions, including but not limited to:
            </p>
<ul class="legal-sublist">
<li><strong>Website Design &amp; Development:</strong> Bespoke corporate websites, marketing landing pages, headless/decoupled architectures, static sites, and Content Management Systems (CMS).</li>
<li><strong>Web Applications &amp; Custom Portals:</strong> Single-page applications (SPAs), secure client portals, dashboards, custom databases, and API integrations.</li>
<li><strong>E-Commerce Solutions:</strong> Online storefront design, catalog setup, inventory workflows, and PCI-compliant third-party checkout integrations.</li>
<li><strong>Branding &amp; UI/UX Architecture:</strong> Brand identity guidelines, logo design, design systems, wireframes, interactive user flows, and high-fidelity clickable prototypes.</li>
<li><strong>Website Care &amp; Support Retainers:</strong> Proactive security patching, core/plugin dependency management, cloud backups, and ongoing technical maintenance.</li>
</ul>
</div>
<div class="clause-block" id="clause-preamble-2">
<p>
<span class="clause-num">0.2</span> <strong>Contracting Capacity &amp; Order Formation:</strong> Services are performed only for individuals and commercial entities who are eighteen (18) years of age or older. An "order" or "engagement" constitutes a legally binding contract formed upon receipt of written or electronic instructions, including signed Statements of Work (SOW), email confirmations, deposit payments, or electronic authorization via the Sheernox Client Portal (<code>my.sheernox.com</code>).
            </p>
</div>
<div class="clause-block" id="clause-preamble-3">
<p>
<span class="clause-num">0.3</span> <strong>SOW Hierarchy:</strong> Where project deliverables, schedules, milestone payments, or technical stacks are specified in an approved Statement of Work, such specifications shall control in the event of any direct conflict with the general terms herein. Infrastructure hosting, domain registrations, and DNS management remain co-governed by the <a href="terms-and-conditions.html">Master Terms and Conditions</a> and <a href="acceptable-use-policy.html">Acceptable Use Policy</a>.
            </p>
</div>
</section>
<!-- Section 1 -->
<section class="legal-section" id="sec-1">
<div class="section-header">
<h2 class="section-title"><span class="section-num">1.0</span> Project Lifecycle &amp; Staging Review</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-1')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>Projects follow a structured, collaborative lifecycle: Discovery → Design &amp; Prototyping → Development → Staging QA → Production Launch. You review working builds on a secure staging server before public release.</p>
</div>
<p>Upon execution of a Statement of Work and receipt of the required initiation deposit, Sheernox schedules and executes the project through the following progressive lifecycle:</p>
<div class="clause-block" id="clause-1-1">
<p>
<span class="clause-num">1.1</span> <strong>Discovery &amp; Technical Architecture:</strong> Sheernox collaborates with Client to define project goals, user journeys, functional specifications, content requirements, and technical architecture documented in the project brief or SOW.
            </p>
</div>
<div class="clause-block" id="clause-1-2">
<p>
<span class="clause-num">1.2</span> <strong>UI/UX Concepts &amp; Prototyping:</strong> Sheernox produces interactive wireframes, component design systems, or visual design concepts for Client review and aesthetic alignment.
            </p>
</div>
<div class="clause-block" id="clause-1-3">
<p>
<span class="clause-num">1.3</span> <strong>Engineering &amp; Integration:</strong> Following design milestone sign-off, Sheernox builds the frontend interfaces, server-side logic, database schemas, third-party API connectors, and content structures.
            </p>
</div>
<div class="clause-block" id="clause-1-4">
<p>
<span class="clause-num">1.4</span> <strong>Staging Review &amp; Quality Assurance:</strong> Prior to public deployment, deliverables are assembled and tested on a secure, authenticated Sheernox staging subdomain for cross-device validation, performance auditing, and Client functional inspection.
            </p>
</div>
<div class="clause-block" id="clause-1-5">
<p>
<span class="clause-num">1.5</span> <strong>Final Delivery &amp; Public Deployment:</strong> Following final milestone acceptance and settlement of project invoices, Sheernox coordinates DNS cutover, SSL certificate provisioning, and production deployment.
            </p>
</div>
</section>
<!-- Section 2 -->
<section class="legal-section" id="sec-2">
<div class="section-header">
<h2 class="section-title"><span class="section-num">2.0</span> Technology Stacks &amp; Architecture Flexibility</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-2')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>Sheernox does not force you into a single platform or proprietary CMS. We engineer solutions across modern CMSs, headless frameworks, static site generators, e-commerce engines, or custom web apps based on what best suits your project requirements.</p>
</div>
<div class="clause-block" id="clause-2-1">
<p>
<span class="clause-num">2.1</span> <strong>Technology Agnostic Architecture:</strong> Sheernox develops across a broad spectrum of modern software stacks. The specific technology stack is chosen collaboratively and detailed in the project SOW, which may include:
            </p>
<ul class="legal-sublist">
<li><strong>Content Management Systems:</strong> Traditional, decoupled, or headless CMS platforms (e.g. WordPress, Shopify, Webflow, Craft CMS, Strapi, Sanity, or Ghost).</li>
<li><strong>Modern Jamstack &amp; Static Frameworks:</strong> Pre-rendered, high-performance static architectures (e.g. Astro, Next.js, Nuxt, SvelteKit, Hugo, or clean semantic HTML5/CSS/JavaScript).</li>
<li><strong>Custom Web Applications:</strong> Bespoke single-page applications, custom relational database architectures (PostgreSQL, MySQL), RESTful/GraphQL APIs, and serverless edge functions.</li>
<li><strong>E-Commerce Platforms:</strong> Tailored shopping carts, automated checkout funnels, catalog filtering, and multi-currency payment processing.</li>
</ul>
</div>
<div class="clause-block" id="clause-2-2">
<p>
<span class="clause-num">2.2</span> <strong>Administrative Access &amp; Handover:</strong> Where an administrative CMS, headless dashboard, or self-service backend is scoped in the SOW, Sheernox configures administrative credentials, security roles, and delivers orientation documentation or training as specified.
            </p>
</div>
<div class="clause-block" id="clause-2-3">
<p>
<span class="clause-num">2.3</span> <strong>Out-of-Scope Hourly Services:</strong> Any feature request, third-party plugin integration, bespoke database migration, or consulting service not itemized in the approved SOW or estimate shall be deemed out of scope and billed on a time-and-materials basis at Sheernox’s prevailing professional hourly rates.
            </p>
</div>
</section>
<!-- Section 3 -->
<section class="legal-section" id="sec-3">
<div class="section-header">
<h2 class="section-title"><span class="section-num">3.0</span> Technical Specifications &amp; Developer Discretion</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-3')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>While project goals, branding, and functional requirements are decided collaboratively with you, Sheernox maintains technical discretion over coding practices, framework patterns, and database structures to ensure code quality, speed, and security.</p>
</div>
<div class="clause-block" id="clause-3-1">
<p>
<span class="clause-num">3.1</span> <strong>Professional Engineering Standards:</strong> Sheernox agrees to build deliverables following industry-recognized web engineering standards, semantic markup conventions, responsive UI principles, accessibility fundamentals, and modern security hardening guidelines.
            </p>
</div>
<div class="clause-block" id="clause-3-2">
<p>
<span class="clause-num">3.2</span> <strong>Technical Discretion:</strong> All decisions regarding specific coding techniques, programming languages, build pipelines, dependency libraries, component structures, database schemas, relational mapping, font subsetting, and responsive implementation logic remain the <strong>professional prerogative of Sheernox Technology Group</strong> in fulfilling the agreed functional requirements of the SOW.
            </p>
</div>
</section>
<!-- Section 4 -->
<section class="legal-section" id="sec-4">
<div class="section-header">
<h2 class="section-title"><span class="section-num">4.0</span> Client Collaboration, Revisions &amp; Sign-off</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-4')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>Design milestones include up to two consolidated rounds of minor revisions. You have 10 business days to provide feedback or approvals; silence beyond 10 days counts as milestone acceptance so schedules stay on track. Dormant projects (30+ days inactive) may incur a reactivation fee.</p>
</div>
<div class="clause-block" id="clause-4-1">
<p>
<span class="clause-num">4.1</span> <strong>Consolidated Revision Rounds:</strong> Unless otherwise specified in the SOW, each design and layout milestone includes up to two (2) consolidated rounds of feedback and minor revisions to typography, color balance, visual assets, and content placement.
            </p>
</div>
<div class="clause-block" id="clause-4-2">
<p>
<span class="clause-num">4.2</span> <strong>10-Day Deemed Acceptance:</strong> Client agrees to review deliverables and provide written feedback or formal milestone approval within ten (10) business days of milestone presentation. Failure to communicate feedback within ten (10) business days constitutes constructive acceptance of that deliverable milestone.
            </p>
</div>
<div class="clause-block" id="clause-4-3">
<p>
<span class="clause-num">4.3</span> <strong>Scope Expansion &amp; Change Orders:</strong> Requests for major structural changes, architectural redesigns, or feature additions exceeding the approved SOW will be scoped under a written Change Order reflecting revised costs and delivery schedules.
            </p>
</div>
<div class="clause-block" id="clause-4-4">
<p>
<span class="clause-num">4.4</span> <strong>Project Dormancy &amp; Reactivation:</strong> If a project is stalled or delayed due to Client inaction, missing assets, or lack of feedback for more than thirty (30) consecutive calendar days, Sheernox may pause the project, invoice for all hours and milestones completed to date, and require a project reactivation fee to re-allocate engineering resources.
            </p>
</div>
</section>
<!-- Section 5 -->
<section class="legal-section" id="sec-5">
<div class="section-header">
<h2 class="section-title"><span class="section-num">5.0</span> Hosting, External Deployments &amp; File Fee</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-5')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>Projects are optimized to run on Sheernox cloud servers. If you choose to host on third-party cloud environments or request an export archive package, a $250 CAD deployment packaging fee covers engineering labor, and third-party hosting server warranties are disclaimed.</p>
</div>
<div class="clause-block" id="clause-5-1">
<p>
<span class="clause-num">5.1</span> <strong>Managed Sheernox Cloud Infrastructure:</strong> Turn-key deployment on Sheernox cloud servers provides integrated performance optimization, automated snapshot backups, SSL management, Anycast CDN edge routing, and 24/7 server monitoring.
            </p>
</div>
<div class="clause-block" id="clause-5-2">
<p>
<span class="clause-num">5.2</span> <strong>External Cloud Hosting &amp; $250 CAD Packaging Fee:</strong> Client may elect to deploy their completed website to a third-party server, cloud platform (e.g. AWS, Cloudflare, Vercel, Netlify, or client-owned infrastructure), or request an offline archive package. External deployment, database migration, and archival bundling automatically incur a <strong>$250.00 CAD deployment &amp; file packaging fee</strong>.
            </p>
<p style="margin-top: 8px; font-size: 0.9rem; color: var(--text-muted);">
<em>Clarification:</em> This fee compensates the DevOps engineering labor required to sanitize configuration secrets, export databases, package assets, and verify dependency compatibility for external third-party environments.
            </p>
</div>
<div class="clause-block" id="clause-5-3">
<p>
<span class="clause-num">5.3</span> <strong>Third-Party Server Warranty Disclaimer:</strong> Deploying to external servers relieves Sheernox from all liability concerning server downtime, third-party infrastructure faults, operating system incompatibilities, or data loss. Sheernox is not responsible for troubleshooting external third-party server environments unless retained under a separate Server Management agreement.
            </p>
</div>
</section>
<!-- Section 6 -->
<section class="legal-section" id="sec-6">
<div class="section-header">
<h2 class="section-title"><span class="section-num">6.0</span> 30-Day Post-Launch Warranty</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-6')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>We stand behind our work. For 30 days after launch, Sheernox will fix any functional bugs or defects that deviate from the approved project scope at no extra charge.</p>
</div>
<div class="clause-block" id="clause-6-1">
<p>
<span class="clause-num">6.1</span> <strong>Thirty-Day Bug Resolution Window:</strong> Sheernox warrants that for thirty (30) calendar days following public production deployment or project handoff, Sheernox will investigate and repair reproducible functional bugs, broken styling, or code defects that fail to conform to the agreed SOW specifications at no additional cost to Client.
            </p>
</div>
<div class="clause-block" id="clause-6-2">
<p>
<span class="clause-num">6.2</span> <strong>Warranty Exclusions:</strong> This warranty does not apply to: (a) issues arising from Client or third-party modifications to source code, databases, or CMS settings; (b) disruptions caused by third-party APIs, plugins, or software updates released after launch; (c) server environment changes on non-Sheernox hosting; or (d) browser deprecations occurring after delivery.
            </p>
</div>
</section>
<!-- Section 7 -->
<section class="legal-section" id="sec-7">
<div class="section-header">
<h2 class="section-title"><span class="section-num">7.0</span> Website Care &amp; Ongoing Maintenance</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-7')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>Ongoing maintenance is not included in initial design packages by default. Once the 30-day warranty ends, clients not enrolled in a Website Care plan are responsible for software updates and security patches. Ongoing support can be added via a monthly maintenance retainer.</p>
</div>
<div class="clause-block" id="clause-7-1">
<p>
<span class="clause-num">7.1</span> <strong>Separate Care Plans:</strong> Website Care packages (including regular core updates, security patches, plugin compatibility testing, automated off-site backups, and uptime monitoring) are offered separately under recurring monthly or annual retainers and are not bundled into base design and development contracts.
            </p>
</div>
<div class="clause-block" id="clause-7-2">
<p>
<span class="clause-num">7.2</span> <strong>Client Upkeep on Unmanaged Sites:</strong> Client acknowledges that if they are not subscribed to an active Website Care plan, Client assumes full responsibility for all software maintenance, security updates, and performance monitoring once the 30-day warranty concludes. Subsequent maintenance, bug fixes, or feature updates will be charged on a per-incident or hourly basis.
            </p>
</div>
</section>
<!-- Section 8 -->
<section class="legal-section" id="sec-8">
<div class="section-header">
<h2 class="section-title"><span class="section-num">8.0</span> Client Materials, Third-Party Assets &amp; APIs</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-8')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>You must own or have rights to all text, logos, and photos you provide to us. You are responsible for commercial font licenses, third-party software subscriptions, and API costs (e.g. Stripe, Google Maps).</p>
</div>
<div class="clause-block" id="clause-8-1">
<p>
<span class="clause-num">8.1</span> <strong>Client Materials &amp; Warranty:</strong> Client warrants that all copy, photographs, trademarks, brand assets, and media provided to Sheernox are owned by Client or properly licensed. Client agrees to defend, indemnify, and hold harmless Sheernox from any third-party intellectual property or copyright claims arising from client-furnished content.
            </p>
</div>
<div class="clause-block" id="clause-8-2">
<p>
<span class="clause-num">8.2</span> <strong>Commercial Fonts, Plugins &amp; API Integrations:</strong> Commercial stock assets, web font licenses, proprietary plugins, and third-party SaaS services (e.g. Stripe, PayPal, Google Maps, SendGrid, Shopify, Algolia) required for project functionality are licensed to Client. Client remains responsible for ongoing software license renewals, SaaS subscription fees, and API usage charges. Sheernox is not liable for changes or outages in third-party API services.
            </p>
</div>
</section>
<!-- Section 9 -->
<section class="legal-section" id="sec-9">
<div class="section-header">
<h2 class="section-title"><span class="section-num">9.0</span> Intellectual Property, Copyright &amp; Code Theft</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-9')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>Once all project invoices are paid in full, full copyright in your custom website design and bespoke code is automatically transferred to you. Taking, scraping, or deploying files before full payment is treated as criminal theft under Canadian law. Sheernox retains the right to showcase the work in our portfolio.</p>
</div>
<div class="clause-block" id="clause-9-1">
<p>
<span class="clause-num">9.1</span> <strong>IP Retention Until Full Payment:</strong> All bespoke visual layouts, custom code, graphics, and project deliverables remain the exclusive intellectual property of Sheernox Technology Group until all project invoices are settled in full.
            </p>
</div>
<div class="clause-block" id="clause-9-2">
<p>
<span class="clause-num">9.2</span> <strong>Automatic Transfer Upon Settlement:</strong> Upon full and final settlement of all project invoices, Sheernox automatically transfers to Customer all right, title, and copyright in the bespoke visual design, layout styling, graphics, and custom source code written specifically for Customer under the SOW.
            </p>
</div>
<div class="clause-block" id="clause-9-3">
<p>
<span class="clause-num">9.3</span> <strong>Pre-Existing Agency Tools &amp; Open Source:</strong> Sheernox retains ownership of its pre-existing codebases, developer boilerplates, internal scripts, and reusable framework components ("Agency Tools"). Sheernox grants Customer a perpetual, worldwide, non-exclusive, royalty-free license to use such Agency Tools solely as incorporated into the delivered project. Third-party open-source libraries (MIT, Apache, GPL) remain subject to their respective open-source licenses.
            </p>
</div>
<div class="clause-block" id="clause-9-4">
<p>
<span class="clause-num">9.4</span> <strong>Criminal Code of Canada Protection:</strong> Any unauthorized extraction, scraping, deployment, or theft of project deliverables or staging assets prior to full payment constitutes criminal theft corresponding to <strong>Sections 322 through 380 of the <em>Criminal Code of Canada</em></strong> (R.S.C., 1985, c. C-46) and will be prosecuted under criminal and civil law.
            </p>
</div>
<div class="clause-block" id="clause-9-5">
<p>
<span class="clause-num">9.5</span> <strong>Portfolio &amp; Case Study Rights:</strong> Sheernox reserves the professional right to showcase completed project designs, screenshots, case studies, and live links in its design portfolio, marketing presentations, and agency promotional channels.
            </p>
</div>
</section>
<!-- Section 10 -->
<section class="legal-section" id="sec-10">
<div class="section-header">
<h2 class="section-title"><span class="section-num">10.0</span> Payment Terms, Deposits &amp; Delinquency</h2>
<button class="clause-anchor-btn" onclick="copyClauseLink('sec-10')" title="Copy link to this section">#</button>
</div>
<div class="key-takeaway">
<span class="takeaway-badge">In Plain English</span>
<p>A 50% non-refundable deposit is required to start work. Invoices are net 30 days, with 1.8% monthly late interest. Unpaid accounts may have staging or site access suspended, and delinquent balances will be pursued through the Small Claims Court of BC with full legal costs.</p>
</div>
<div class="clause-block" id="clause-10-1">
<p>
<span class="clause-num">10.1</span> <strong>50% Non-Refundable Deposit:</strong> Unless an alternative milestone payment schedule is stipulated in the SOW, Customer shall pay an initiation deposit equal to fifty percent (50%) of the total project estimate prior to work commencement. The initiation deposit is non-refundable.
            </p>
</div>
<div class="clause-block" id="clause-10-2">
<p>
<span class="clause-num">10.2</span> <strong>Milestone Settlements:</strong> Subsequent milestone payments are due upon completion of designated project phases, with final balances payable prior to public production release or code repository handoff.
            </p>
</div>
<div class="clause-block" id="clause-10-3">
<p>
<span class="clause-num">10.3</span> <strong>Net 30 Terms &amp; 1.8% Monthly Late Interest:</strong> Invoices are payable net thirty (30) days from issuance. Overdue balances accrue late interest at <strong>1.8% per month (23.87% per annum compounded monthly)</strong> for each month or fraction thereof that payment remains outstanding.
            </p>
</div>
<div class="clause-block" id="clause-10-4">
<p>
<span class="clause-num">10.4</span> <strong>Suspension Remedies:</strong> In the event of non-payment or uncommunicated payment delays, Sheernox may pause active work, disable staging or live website access, and remove project web pages from public view until accounts are brought current.
            </p>
</div>
<div class="clause-block" id="clause-10-5">
<p>
<span class="clause-num">10.5</span> <strong>Small Claims Court Enforcement:</strong> Sheernox reserves the right to pursue unpaid accounts through the <strong>Small Claims Court of British Columbia</strong> or the Supreme Court of British Columbia. Customer agrees to pay all collection agency expenses, court filing fees, and legal fees incurred by Sheernox on a full <strong>solicitor-and-own-client indemnity basis</strong>.
            </p>
</div>
</section>
<!-- Section 11 -->
<section class="legal-section" id="sec-11">
<div class="section-header">
